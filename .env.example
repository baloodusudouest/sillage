# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis maison (12 caractères au moins).
MAISON_PASSWORD=change-moi-12-caracteres-minimum

# Jeton commun des applis maison (une longue chaîne au hasard) : envoyé à carnet, à Chambre noire et à l'Anneau
# (annuaire, sauvegarde des réglages). Vide : personnes d'Immich seules, pas de sauvegarde des réglages.
# MAISON_JETON=un-long-jeton-commun

# Clé d'API créée dans Immich pour Sillage, limitée à la lecture :
# person.read, asset.read, asset.view, album.read, tag.read (scans datés par Millésime)
SILLAGE_IMMICH_CLE=

# Jeton propre à Home Assistant pour préparer les pages des chambres (/ha/sejour). Vide : adresse fermée.
# SILLAGE_JETON_HA=un-autre-long-jeton

# Dossier du NAS pour l'état de Sillage
SILLAGE_DATA_DIR=/volume1/docker/sillage

# Facultatif
# PORT_SILLAGE=8093

# 0.16 : les réglages d'usage (mots des temps forts, dossiers muets, place des vignettes, tags de Millésime) se règlent
# dans l'écran Réglages de Sillage, plus dans la stack.
