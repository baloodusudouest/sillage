# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins). 0.15 : MAISON_PASSWORD ;
# l'ancien SILLAGE_PASSWORD reste lu en repli tant que MAISON_PASSWORD est absent.
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# SILLAGE_PASSWORD=change-moi-12-caracteres-minimum

# 0.15 : jeton commun des applis maison (une longue chaîne au hasard) : envoyé à carnet et à l'Anneau (annuaire).
# MAISON_JETON=un-long-jeton-commun

# Clé d'API créée dans Immich pour Sillage, limitée à la lecture :
# person.read, asset.read, asset.view, album.read, tag.read (0.14 : scans datés par Millésime)
SILLAGE_IMMICH_CLE=

# Dossier du NAS pour l'état de Sillage
SILLAGE_DATA_DIR=/volume1/docker/sillage

# Ancien jeton partagé avec carnet (CARNET_JETON_SILLAGE) : envoyé avant MAISON_JETON tant qu'il est posé.
# Les deux vides : personnes d'Immich seules.
SILLAGE_CARNET_JETON=

# Facultatif
# PORT_SILLAGE=8093
# Adresse d'Immich dans le navigateur : repli quand l'Anneau ne connaît pas la tuile « Immich » (0.15)
# SILLAGE_IMMICH_ADRESSE=http://adresse-d-immich:2283
# SILLAGE_DOSSIERS_MUETS=Un dossier fourre-tout,Un autre
# SILLAGE_MOTS=mariage,baptême,anniversaire
# 0.14 : tags posés par Millésime. Début des tags d'estimation (« Date estimée/1975 ±3 ») ; vide : pas lu.
# SILLAGE_TAG_ESTIMEE=Date estimée
# Tag complet des scans pas encore datés (le même que dans Millésime) ; vide : pas lu, ces scans gardent leur date d'Immich.
# SILLAGE_TAG_NON_DATEE=Mon préfixe/Non datée
